# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
/firebase/node_modules
/firebase/lib

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# wrangler
.wrangler/
.dev.vars

# Heavy source media stays outside Git. WebP is deliberately NOT listed: it is the
# delivery format the site actually renders, and Cloudflare builds from Git, so an
# ignored image ships as a 404.
public/**/*.png
public/**/*.jpg
public/**/*.jpeg
public/**/*.gif
public/**/*.mp4
public/**/*.mp3

# Exception: essential branding assets that must be in Git
!public/og-image.png
!public/og-image.jpg
!public/icon-192.png
!public/icon-512.png
!public/website-icon.png
!public/storywell-name.png

# generated by the discovery workaround (see aso/ua_gift_codes/channels.md)
firebase/functions.yaml
