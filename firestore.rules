rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Stories collection: Allow admin users to read and write
    // This is needed for the admin-panel to manage stories
    match /stories/{storyId} {
      allow read, write: if isAdmin();
      
      // Allow public read for published stories (web + mobile clients)
      allow read: if resource.data.isPublished == true;
      
      // Pages subcollection
      match /pages/{pageId} {
        allow read, write: if isAdmin();
        // Allow public read for pages of published stories
        allow read: if get(/databases/$(database)/documents/stories/$(storyId)).data.isPublished == true;
      }
    }

    // Config collection: Allow admin users to read and write
    match /config/{document=**} {
      allow read, write: if isAdmin();
      // Allow public read for global config (used by clients)
      allow read: if true;
    }

    // Opinions collection: Restricted - only accessible via Cloud Functions (Admin SDK)
    // No direct client access allowed
    match /opinions/{opinionId} {
      allow read, write: if false;
    }

    // User preferences: Users can only access their own data
    match /user_prefs/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default: Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


